{
  "name": "slopblock",
  "version": "0.1.0",
  "description": "Browser extension that blurs AI-generated posts in your feeds, on-device, and tells you why.",
  "license": "MIT",
  "author": "Arthur (https://github.com/Arthur031221)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arthur031221/slopblock.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "vitest run",
    "lint": "biome check . && tsc --noEmit",
    "format": "biome format --write .",
    "bench": "node bench/run.ts",
    "demo": "node demo/capture.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/chrome": "0.3.4",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.3",
    "esbuild": "0.28.2",
    "jsdom": "30.1.1",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
